import type { Metadata } from "next";
import { Bricolage_Grotesque, Public_Sans, JetBrains_Mono } from "next/font/google";
import "./globals.css";

/* Display: wide, variable, characterful. Used with restraint â€” headline
   and section titles only. */
const bricolage = Bricolage_Grotesque({
  variable: "--font-bricolage",
  subsets: ["latin"],
  display: "swap",
  weight: ["400", "600", "700"],
});

/* Body: quiet and highly legible, carries all reading text. */
const publicSans = Public_Sans({
  variable: "--font-public-sans",
  subsets: ["latin"],
  display: "swap",
});

/* Utility: skill levels, dates, platform tags. Anything that is data
   rather than prose. */
const jetbrains = JetBrains_Mono({
  variable: "--font-jetbrains",
  subsets: ["latin"],
  display: "swap",
  weight: ["400", "500"],
});

export const metadata: Metadata = {
  title: "Oussema Mansouri â€” Mobile Developer (iOS, Flutter, Android)",
  description:
    "Mobile developer and instructor in Tunis. Native iOS with Swift and SwiftUI, cross-platform Flutter, native Android.",
};

export default function RootLayout({
  children,
}: Readonly<{ children: React.ReactNode }>) {
  return (
    <html lang="en">
      <body
        className={`${bricolage.variable} ${publicSans.variable} ${jetbrains.variable}`}
      >
        {children}
      </body>
    </html>
  );
}
