@import "tailwindcss";

/* ==================================================================
   Design tokens
   Direction: precise and light. A cool sage paper, near-black ink,
   and a single electric indigo accent held apart from Swift orange,
   Flutter blue and Android green so platform names never clash.
   ================================================================== */

@theme {
  /* --- Colour ------------------------------------------------- */
  --color-paper: #f1f3f0;
  --color-paper-raised: #fafbf9;
  --color-ink: #141a17;
  --color-ink-muted: #6b7a72;
  --color-line: #d5dad4;
  --color-accent: #3b2fbf;
  --color-accent-soft: #ebe9fb;

  /* Availability states â€” semantic, not decorative */
  --color-status-available: #1e7a4a;
  --color-status-open: #8a6a12;
  --color-status-closed: #7a2f2f;

  /* --- Type --------------------------------------------------- */
  --font-display: var(--font-bricolage), ui-sans-serif, system-ui, sans-serif;
  --font-body: var(--font-public-sans), ui-sans-serif, system-ui, sans-serif;
  --font-mono: var(--font-jetbrains), ui-monospace, monospace;

  /* Scale â€” a large jump between display and body is what carries
     the personality. Deliberately not a uniform 1.25 ratio. */
  --text-display: 4.25rem;
  --text-display--line-height: 0.94;
  --text-display--letter-spacing: -0.035em;
  --text-title: 2.25rem;
  --text-title--line-height: 1.05;
  --text-title--letter-spacing: -0.02em;
  --text-lead: 1.3125rem;
  --text-lead--line-height: 1.45;
  --text-eyebrow: 0.75rem;
  --text-eyebrow--line-height: 1;
  --text-eyebrow--letter-spacing: 0.12em;

  /* --- Layout ------------------------------------------------- */
  --spacing-gutter: 1.5rem;
  --spacing-section: 7rem;
  --radius-device: 2.25rem;
}

/* ==================================================================
   Base
   ================================================================== */

@layer base {
  html {
    scroll-behavior: smooth;
  }

  body {
    background-color: var(--color-paper);
    color: var(--color-ink);
    font-family: var(--font-body);
    -webkit-font-smoothing: antialiased;
    text-rendering: optimizeLegibility;
  }

  /* Visible keyboard focus everywhere. Non-negotiable for WCAG AA. */
  :focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 3px;
    border-radius: 2px;
  }

  ::selection {
    background-color: var(--color-accent);
    color: var(--color-paper);
  }
}

@media (prefers-reduced-motion: reduce) {
  *,
  *::before,
  *::after {
    animation-duration: 0.01ms !important;
    animation-iteration-count: 1 !important;
    transition-duration: 0.01ms !important;
    scroll-behavior: auto !important;
  }
}

/* ==================================================================
   Components
   ================================================================== */

@layer components {
  /* Eyebrow â€” carries platform tags and section labels.
     Structural, not decorative: it always names something true. */
  .eyebrow {
    font-family: var(--font-mono);
    font-size: var(--text-eyebrow);
    letter-spacing: var(--text-eyebrow--letter-spacing);
    text-transform: uppercase;
    color: var(--color-ink-muted);
  }

  /* Hairline rules rather than boxes â€” the page is held together by
     alignment and space, not by containers. */
  .rule {
    border-top: 1px solid var(--color-line);
  }

  .link-underline {
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.25em;
    text-decoration-color: var(--color-line);
    transition: text-decoration-color 150ms ease;
  }

  .link-underline:hover {
    text-decoration-color: var(--color-accent);
  }
}
